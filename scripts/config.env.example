# ESP32-WiFi-Breathing - Runtime config template
# Copy to scripts/config.env and fill with your local values.

# Serial
SERIAL_PORT=COM16
BAUD_RATE=115200

# AWS IoT Core
AWS_IOT_ENDPOINT=YOUR_AWS_IOT_ENDPOINT
AWS_IOT_CLIENT_ID=basicPubSub

# Certificate paths (relative to project root)
AWS_CERT_PATH=certs/device.cert.pem
AWS_KEY_PATH=certs/device.private.key
AWS_CA_PATH=certs/root-CA.pem

# Telegram
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
DEVICE_ID=pc-host-01

# Measurement
MEASURE_SECONDS=60
SAMPLING_RATE=100
MODEL_WINDOW_SECONDS=60
MODEL_SAMPLING_RATE=10
